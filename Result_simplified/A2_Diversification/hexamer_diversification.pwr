begin model

## Reserved Parameters::
#   loop_coop: a list of loop cooperativity factors, one for each rule.

begin parameters
    default_assoc   1.
    rxn_coupling True
    monomer_add_only False
end parameters

begin species
    A(a,b,c) 100.0 umol
    C(a,b,c) 100.0 umol
    B(a,b) 100.0 umol
    D(a,b) 100.0 umol
    E(a,b) 100.0 umol
    F(a,b) 100.0 umol
end species

begin observables
    full_complex    A(a!1,b!1,c!).B(a!1,b!1).C(a!1,b!1).D(a!1).E(a!1).F(a!1)
    momomer_A   A(a,b,c)
    monomer_B   B(a,b)
    monomer_C   C(a,b)
    monomer_D   D(a)
    monomer_E   E(a)
    monomer_F   F(a)
end observables

begin rules
    A(a)+B(b)<->A(a!1).B(a!1)  G=-20.0	
    A(b)+C(a)<->A(b!1).C(a!1)  G=-20.0
    A(c)+D(a)<->A(c!1).D(a!1)  G=-20.0
    A(c)+E(a)<->A(c!1).E(a!1)  G=-20.0
    A(c)+F(a)<->A(c!1).F(a!1)  G=-20.0
    B(b)+C(b)<->B(b!1).C(b!1)  G=-20.0
    B(c)+D(b)<->B(c!1).D(b!1)  G=-20.0
    B(c)+E(b)<->B(c!1).E(b!1)  G=-20.0
    B(c)+F(b)<->B(c!1).F(b!1)  G=-20.0
    C(c)+D(b)<->C(c!1).D(b!1)  G=-20.0
    C(c)+E(b)<->C(c!1).E(b!1)  G=-20.0
    C(c)+F(b)<->C(c!1).F(b!1)  G=-20.0
    D(c)+E(b)<->D(c!1).E(b!1)  G=-20.0
    D(c)+F(b)<->D(c!1).F(b!1)  G=-20.0
    E(c)+F(b)<->E(c!1).F(b!1)  G=-20.0
end rules
